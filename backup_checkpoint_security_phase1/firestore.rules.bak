rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'furniturefixservice@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAssignedTech(techId) {
      return isSignedIn() && (
        request.auth.uid == techId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.technicianId == techId)
      );
    }

    // Admins master collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Users collection with strict RBAC
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Users can register their own profile, but cannot self-assign the 'admin' role
      allow create: if isOwner(userId) && (
        (incoming().role == 'customer' || incoming().role == 'technician') ||
        isAdmin()
      );
      // Non-admins cannot elevate their own role
      allow update: if (isOwner(userId) && incoming().role == existing().role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Customer profiles
    match /customers/{customerId} {
      allow get: if isOwner(customerId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(customerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Technicians master list
    match /technicians/{technicianId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2026 Customer Tariff Service Catalogue
    match /services/{serviceId} {
      allow read: if true; // Public catalogue
      allow write: if isAdmin();
    }

    // Bookings & Jobs
    match /bookings/{bookingId} {
      // Admin sees all. Customers see their own. Technicians see only assigned jobs.
      // Also allow direct lookup by valid Job ID for customer real-time tracking
      allow get: if isAdmin() || (
        isSignedIn() && (
          existing().customerId == request.auth.uid ||
          isAssignedTech(existing().assignedTechId)
        )
      ) || isValidId(bookingId);

      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          isAssignedTech(resource.data.assignedTechId)
        )
      );

      // Bookings can be created by authenticated users or with valid customer contact info
      allow create: if isSignedIn() || (
        incoming().customerPhone is string &&
        incoming().finalTotal is number
      );

      // Updates partitioned by role
      allow update: if isAdmin() || (
        // Assigned technician updating status / completion / payment
        isAssignedTech(existing().assignedTechId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'description', 'completionPhotoUrls', 'paymentStatus', 'paymentMethod', 'paymentReference', 'statusHistory', 'addOns'
        ])
      ) || (
        // Customer approving add-ons / payment collection
        isSignedIn() && existing().customerId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'addOns', 'finalTotal', 'technicianPayout', 'platformMargin', 'paymentStatus', 'paymentMethod', 'paymentReference', 'status', 'statusHistory'
        ])
      ) || (
        // Unauthenticated customer paying or approving add-ons with matching phone
        incoming().diff(existing()).affectedKeys().hasOnly([
          'addOns', 'finalTotal', 'technicianPayout', 'platformMargin', 'paymentStatus', 'paymentMethod', 'paymentReference', 'status', 'statusHistory'
        ]) &&
        incoming().customerPhone == existing().customerPhone
      );

      allow delete: if isAdmin();

      // Subcollection: Status History
      match /statusHistory/{historyId} {
        allow read: if isAdmin() || (
          isSignedIn() && (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
            isAssignedTech(get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedTechId)
          )
        ) || isValidId(bookingId);
        allow create: if isAdmin() || isSignedIn() || true;
        allow update, delete: if false; // Immutable audit log
      }

      // Subcollection: Onsite Add-Ons
      match /addOns/{addOnId} {
        allow read: if isAdmin() || (
          isSignedIn() && (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
            isAssignedTech(get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedTechId)
          )
        ) || isValidId(bookingId);
        allow create: if isAdmin() || isAssignedTech(get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedTechId);
        allow update: if isAdmin() || (
          isSignedIn() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid
        ) || true;
        allow delete: if isAdmin();
      }
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && isAssignedTech(existing().collectedBy));
      allow create: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Technician Payouts
    match /payouts/{payoutId} {
      allow read: if isAdmin() || (isSignedIn() && isAssignedTech(existing().technicianId));
      allow write: if isAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
